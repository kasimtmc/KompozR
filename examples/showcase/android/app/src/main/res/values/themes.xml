<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- KompozR draws everything: the theme only sets the window's background before the first frame and the
         system bars' icons. -->
    <style name="KompozTheme" parent="@android:style/Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
