{
  "$comment": "Kotlin inside kompoz! in Rust sources: kompoz! { ... }, kompoz!( ... ) and kompoz![ ... ] (the delimiter on kompoz!'s line or at the start of a later one), the Kotlin highlighted as Kotlin (source.kotlin.kompozr) up to the delimiter that closes the macro's, the braces, parentheses and brackets in between balanced (strings, characters and comments with a closing one in them read as such). The Rust after it is Rust again. kompoz_file!(\"screen.kt\") is a plain macro call, left to the Rust grammar.",
  "scopeName": "kompozr.injection.rust",
  "injectionSelector": "L:source.rust -comment -string -meta.embedded.block.kotlin",
  "patterns": [
    {
      "include": "#kompoz-braces"
    },
    {
      "include": "#kompoz-parens"
    },
    {
      "include": "#kompoz-brackets"
    },
    {
      "include": "#kompoz-later"
    }
  ],
  "repository": {
    "kompoz-braces": {
      "name": "meta.macro.kompoz.rust",
      "begin": "\\b(kompoz!)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        },
        "2": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.curly.rust"
        }
      },
      "contentName": "meta.embedded.block.kotlin",
      "patterns": [
        {
          "include": "source.kotlin.kompozr"
        }
      ]
    },
    "kompoz-parens": {
      "name": "meta.macro.kompoz.rust",
      "begin": "\\b(kompoz!)\\s*(\\()",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        },
        "2": {
          "name": "punctuation.brackets.round.rust"
        }
      },
      "end": "\\)",
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.round.rust"
        }
      },
      "contentName": "meta.embedded.block.kotlin",
      "patterns": [
        {
          "include": "#kotlin-in-delimiters"
        }
      ]
    },
    "kompoz-brackets": {
      "name": "meta.macro.kompoz.rust",
      "begin": "\\b(kompoz!)\\s*(\\[)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        },
        "2": {
          "name": "punctuation.brackets.square.rust"
        }
      },
      "end": "\\]",
      "endCaptures": {
        "0": {
          "name": "punctuation.brackets.square.rust"
        }
      },
      "contentName": "meta.embedded.block.kotlin",
      "patterns": [
        {
          "include": "#kotlin-in-delimiters"
        }
      ]
    },
    "kotlin-in-delimiters": {
      "$comment": "The Kotlin balances its braces itself; its parentheses and brackets are balanced here, so that the macro's ) or ] is the one that closes it.",
      "patterns": [
        {
          "include": "#parens"
        },
        {
          "include": "#brackets"
        },
        {
          "include": "source.kotlin.kompozr"
        }
      ]
    },
    "parens": {
      "begin": "\\(",
      "end": "\\)",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.parens.begin.kotlin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.parens.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "#kotlin-in-delimiters"
        }
      ]
    },
    "brackets": {
      "begin": "\\[",
      "end": "\\]",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.brackets.begin.kotlin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.brackets.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "#kotlin-in-delimiters"
        }
      ]
    },
    "kompoz-later": {
      "$comment": "kompoz! at the end of its line, its delimiter at the start of a later one; anything else there and it was a Rust macro after all.",
      "name": "meta.macro.kompoz.rust",
      "begin": "\\b(kompoz!)\\s*$",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.macro.rust"
        }
      },
      "end": "(?<=[})\\]])|(?=[^\\s{(\\[])",
      "patterns": [
        {
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brackets.curly.rust"
            }
          },
          "end": "\\}",
          "endCaptures": {
            "0": {
              "name": "punctuation.brackets.curly.rust"
            }
          },
          "contentName": "meta.embedded.block.kotlin",
          "patterns": [
            {
              "include": "source.kotlin.kompozr"
            }
          ]
        },
        {
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brackets.round.rust"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.brackets.round.rust"
            }
          },
          "contentName": "meta.embedded.block.kotlin",
          "patterns": [
            {
              "include": "#kotlin-in-delimiters"
            }
          ]
        },
        {
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.brackets.square.rust"
            }
          },
          "end": "\\]",
          "endCaptures": {
            "0": {
              "name": "punctuation.brackets.square.rust"
            }
          },
          "contentName": "meta.embedded.block.kotlin",
          "patterns": [
            {
              "include": "#kotlin-in-delimiters"
            }
          ]
        }
      ]
    }
  }
}
